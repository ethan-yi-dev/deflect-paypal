# Existing PayPal Sandbox credentials
PAYPAL_CLIENT_ID=anyword
PAYPAL_SECRET=anyword

# PostgreSQL with the pgvector extension (see compose.yaml).
DATABASE_URL=postgresql://deflect:anyword@localhost:5432/deflect

# Bound to the knowledge base on first use. Do not change for an existing base.
KNOWLEDGE_BASE_ID=default
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768

# Google AI Studio: https://aistudio.google.com/apikey
# Sent server-side as: x-goog-api-key: <GEMINI_API_KEY>
GEMINI_API_KEY=anyword

# LlamaParse: https://cloud.llamaindex.ai/api-key
# Sent server-side as: Authorization: Bearer <LLAMA_CLOUD_API_KEY>
LLAMA_CLOUD_API_KEY=anyword
LLAMA_PARSE_TIER=agentic

# Cohere Rerank: https://dashboard.cohere.com/api-keys
# POST https://api.cohere.com/v2/rerank
# Sent server-side as: Authorization: Bearer <COHERE_API_KEY>
# Missing/placeholder keys keep vector search available with an explicit warning.
COHERE_API_KEY=anyword
COHERE_RERANK_MODEL=rerank-v4.0-fast
KNOWLEDGE_RERANK_CANDIDATES=50
KNOWLEDGE_RERANK_TIMEOUT_MS=10000
